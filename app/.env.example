# Database (MySQL / MariaDB)
DATABASE_URL="mysql://absensi:change-me@127.0.0.1:3306/absensi_dev"

# Runtime
NODE_ENV="development"

# Perimeter: aktifkan hanya di belakang reverse proxy tepercaya yang
# menimpa X-Forwarded-For. Default false = header proxy tidak dipercaya.
TRUST_PROXY="false"

# Dev-only: echo token undangan di respons API. Diabaikan saat NODE_ENV=production.
S1_INVITATION_TOKEN_ECHO="false"

# Redis rate limiter (wajib di production; fail-closed bila tidak tersedia)
REDIS_URL="redis://127.0.0.1:6379"
# Hanya untuk dev/test lokal; production tanpa Redis akan menolak request.
# S1_RATE_LIMITER="memory"

# Email: dev memakai console; production wajib SMTP/provider (fail-closed).
# EMAIL_TRANSPORT="smtp" | "resend" | "sendgrid" | "memory" | "console"
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
FROM_EMAIL="noreply@example.com"
APP_BASE_URL="http://localhost:3000"

# Enkripsi secret TOTP 2FA (32 byte hex atau base64). Wajib di production.
TWO_FACTOR_ENCRYPTION_KEY=""

# Revisi kehadiran (Phase 4)
REVISION_WINDOW_DAYS="7"
REVISION_MONTHLY_LIMIT="1"

# Penyimpanan privat di luar public/; akses hanya lewat endpoint ber-otorisasi.
ATTENDANCE_PROOF_DIR="storage/proofs"
ATTENDANCE_PHOTO_DIR="storage/attendance"

# Worker: interval scheduler dan umur token perangkat sebelum dibersihkan.
WORKER_INTERVAL_MS="60000"
DEVICE_TOKEN_TTL_DAYS="60"
