{
  "name": "@absensi/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./security-headers": {
      "types": "./dist/security-headers.d.ts",
      "default": "./dist/security-headers.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-force-exit --test-concurrency=1 dist"
  },
  "dependencies": {
    "@absensi/database": "0.1.0",
    "@absensi/permissions": "0.1.0",
    "@node-rs/argon2": "2.2.2",
    "firebase-admin": "14.5.1",
    "nodemailer": "^10.6.0",
    "smtp-server": "^3.21.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "typescript": "7.0.2"
  }
}
