  validationStatus   String    @default("VALID") @map("validation_status") @db.VarChar(20)
  reviewedByMemberId String?   @map("reviewed_by_member_id") @db.Char(36)
  reviewedAt         DateTime? @map("reviewed_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule  ClientVisitSchedule? @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Cascade)
  client    Client?              @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  member    WorkspaceMember      @relation("ClientVisitLogMember", fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  reviewer  WorkspaceMember?     @relation("ClientVisitLogReviewer", fields: [tenantId, reviewedByMemberId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, scheduleId, type])
  @@index([tenantId, memberId, timestampServer])
  @@index([tenantId, clientId, timestampServer])
  @@index([tenantId, clientName])
  @@index([tenantId, validationStatus])
  @@map("client_visit_logs")
}

model WorkProjection {
  id                 String    @id @db.Char(36)
  tenantId           String    @map("tenant_id") @db.Char(36)
  memberId           String    @map("member_id") @db.Char(36)
  title              String    @db.VarChar(160)
  description        String?   @db.VarChar(1000)
  periodType         String    @map("period_type") @db.VarChar(20)
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  progress           Int       @default(0)
  status             String    @default("PLANNED") @db.VarChar(20)
  blockerNote        String?   @map("blocker_note") @db.VarChar(1000)
  reviewNote         String?   @map("review_note") @db.VarChar(1000)
  reviewedByMemberId String?   @map("reviewed_by_member_id") @db.Char(36)
  reviewedAt         DateTime? @map("reviewed_at") @db.DateTime(3)
  createdByMemberId  String    @map("created_by_member_id") @db.Char(36)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    WorkspaceMember  @relation("WorkProjectionMember", fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  creator   WorkspaceMember  @relation("WorkProjectionCreator", fields: [tenantId, createdByMemberId], references: [tenantId, id], onDelete: Restrict)
  reviewer  WorkspaceMember? @relation("WorkProjectionReviewer", fields: [tenantId, reviewedByMemberId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, memberId, startDate])
  @@index([tenantId, status, endDate])
  @@map("work_projections")
}

model PayrollSetting {
  id                       String   @id @db.Char(36)
  tenantId                 String   @unique @map("tenant_id") @db.Char(36)
  currency                 String   @default("IDR") @db.VarChar(3)
  baseSalary               Int      @default(0) @map("base_salary")
  attendanceAllowance      Int      @default(0) @map("attendance_allowance")
  transportAllowance       Int      @default(0) @map("transport_allowance")
  mealAllowance            Int      @default(0) @map("meal_allowance")
  overtimeHourlyRate       Int      @default(0) @map("overtime_hourly_rate")
  lateDeductionPerMinute   Int      @default(0) @map("late_deduction_per_minute")
  lateDeductionPerIncident Int      @default(0) @map("late_deduction_per_incident")
  sp1Deduction             Int      @default(0) @map("sp1_deduction")
  sp2Deduction             Int      @default(0) @map("sp2_deduction")
  sp3Deduction             Int      @default(0) @map("sp3_deduction")
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@map("payroll_settings")
}

model MemberCompensation {
  id                  String    @id @db.Char(36)
  tenantId            String    @map("tenant_id") @db.Char(36)
  memberId            String    @map("member_id") @db.Char(36)
  baseSalary          Int?      @map("base_salary")
  attendanceAllowance Int?      @map("attendance_allowance")
  transportAllowance  Int?      @map("transport_allowance")
  mealAllowance       Int?      @map("meal_allowance")
  overtimeHourlyRate  Int?      @map("overtime_hourly_rate")
  effectiveFrom       DateTime? @map("effective_from") @db.Date
  notes               String?   @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, memberId])
  @@map("member_compensations")
}

model PayrollRun {
  id                  String    @id @db.Char(36)
  tenantId            String    @map("tenant_id") @db.Char(36)
  periodYear          Int       @map("period_year")
  periodMonth         Int       @map("period_month")
  status              String    @default("DRAFT") @db.VarChar(20)
  currency            String    @default("IDR") @db.VarChar(3)
  totalGross          Int       @default(0) @map("total_gross")
  totalDeductions     Int       @default(0) @map("total_deductions")
  totalNet            Int       @default(0) @map("total_net")
  notes               String?   @db.VarChar(1000)
  generatedByMemberId String    @map("generated_by_member_id") @db.Char(36)
  finalizedAt         DateTime? @map("finalized_at") @db.DateTime(3)
  paidAt              DateTime? @map("paid_at") @db.DateTime(3)
  paymentReference    String?   @map("payment_reference") @db.VarChar(120)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generator WorkspaceMember @relation("PayrollRunGenerator", fields: [tenantId, generatedByMemberId], references: [tenantId, id], onDelete: Restrict)
  items     PayrollItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId, status, periodYear, periodMonth])
  @@map("payroll_runs")
}

model PayrollItem {
  id                  String   @id @db.Char(36)
  tenantId            String   @map("tenant_id") @db.Char(36)
  runId               String   @map("run_id") @db.Char(36)
  memberId            String   @map("member_id") @db.Char(36)
  baseSalary          Int      @default(0) @map("base_salary")
  attendanceAllowance Int      @default(0) @map("attendance_allowance")
  transportAllowance  Int      @default(0) @map("transport_allowance")
  mealAllowance       Int      @default(0) @map("meal_allowance")
  overtimeMinutes     Int      @default(0) @map("overtime_minutes")
  overtimeRate        Int      @default(0) @map("overtime_rate")
  overtimePay         Int      @default(0) @map("overtime_pay")
  lateMinutes         Int      @default(0) @map("late_minutes")
  lateIncidents       Int      @default(0) @map("late_incidents")
  lateDeduction       Int      @default(0) @map("late_deduction")
  spLevel             String?  @map("sp_level") @db.VarChar(10)
  spDeduction         Int      @default(0) @map("sp_deduction")
  leaveDays           Int      @default(0) @map("leave_days")
  permitDays          Int      @default(0) @map("permit_days")
  grossPay            Int      @default(0) @map("gross_pay")
  totalDeductions     Int      @default(0) @map("total_deductions")
  netPay              Int      @default(0) @map("net_pay")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace Workspace       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run       PayrollRun      @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, runId, memberId])
  @@index([tenantId, memberId, createdAt])
  @@map("payroll_items")
}

model InAppNotification {
  id        String    @id @db.Char(36)
  tenantId  String    @map("tenant_id") @db.Char(36)
  memberId  String    @map("member_id") @db.Char(36)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(1000)
  linkUrl   String?   @map("link_url") @db.VarChar(512)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  workspace Workspace       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, memberId, isRead, createdAt])
  @@index([tenantId, memberId, createdAt])
  @@map("in_app_notifications")
}

model BackgroundJob {
  id             String   @id @db.Char(36)
  tenantId       String   @map("tenant_id") @db.Char(36)
  type           String   @db.VarChar(64)
  payload        Json
  status         String   @default("PENDING") @db.VarChar(20)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(128)
  runAt          DateTime @map("run_at") @db.DateTime(3)
  attempts       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  workspace   Workspace              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attemptsLog BackgroundJobAttempt[]

  @@index([tenantId, status])
  @@map("background_jobs")
}

model BackgroundJobAttempt {
  id         String    @id @db.Char(36)
  jobId      String    @map("job_id") @db.Char(36)
  attempt    Int
  status     String    @db.VarChar(20)
  error      String?   @db.VarChar(1000)
  startedAt  DateTime  @map("started_at") @db.DateTime(3)
  finishedAt DateTime? @map("finished_at") @db.DateTime(3)

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("background_job_attempts")
}
